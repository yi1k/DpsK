{
  "name": "dsh-desktop",
  "productName": "DeepSeek Harness",
  "version": "0.2.0",
  "description": "DeepSeek Harness 桌面端 —— 内嵌 DSH Web GUI 的 Electron 客户端，支持通过 GitHub Releases 自动更新",
  "author": "DeepSeek Harness",
  "license": "MIT",
  "main": "src/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/yi1k/DpsK.git"
  },
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/generate-icon.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "publish": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.deepseek.harness.desktop",
    "productName": "DeepSeek Harness",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness",
      "artifactName": "DeepSeek-Harness-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "yi1k",
      "repo": "DpsK",
      "releaseType": "release"
    }
  }
}
